{
  "name": "@django9944/antigravity-theme",
  "version": "0.1.0",
  "description": "Matte glass Dark & Light theme pack for the Antigravity 2.0 Agent Desktop App — engineered with OKLCH design tokens and APCA/WCAG contrast gates.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Django9944/antigravity-theme.git"
  },
  "homepage": "https://github.com/Django9944/antigravity-theme#readme",
  "bugs": {
    "url": "https://github.com/Django9944/antigravity-theme/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "antigravity",
    "antigravity-agent",
    "theme",
    "design-tokens",
    "oklch",
    "glassmorphism",
    "css-variables",
    "apca"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./manifest.json": "./dist/manifest.json",
    "./antigravity-dark/*": "./dist/antigravity-dark/*",
    "./antigravity-light/*": "./dist/antigravity-light/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsx src/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:release": "tsx scripts/pack-release.ts",
    "check:upstream": "tsx scripts/check-upstream-app.ts",
    "preview": "tsx scripts/serve-preview.ts",
    "ci:version": "changeset version && pnpm build",
    "ci:publish": "pnpm pack:release && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.14.0",
    "ajv": "^8.17.1",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "shiki": "^3.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
