{
  "name": "@django9944/antigravity-theme",
  "version": "0.2.1",
  "description": "OKLCH matte & aurora glass theme system (7 families × Dark/Light) + zero-resign macOS/Windows desktop ASAR patcher for Antigravity.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Django9944/antigravity-theme.git"
  },
  "homepage": "https://github.com/Django9944/antigravity-theme#readme",
  "bugs": {
    "url": "https://github.com/Django9944/antigravity-theme/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "antigravity",
    "antigravity-agent",
    "theme",
    "design-tokens",
    "oklch",
    "glassmorphism",
    "css-variables",
    "apca"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./manifest.json": "./dist/manifest.json",
    "./antigravity-dark/*": "./dist/antigravity-dark/*",
    "./antigravity-light/*": "./dist/antigravity-light/*",
    "./antigravity-prism-dark/*": "./dist/antigravity-prism-dark/*",
    "./antigravity-prism-light/*": "./dist/antigravity-prism-light/*",
    "./antigravity-zenith-dark/*": "./dist/antigravity-zenith-dark/*",
    "./antigravity-zenith-light/*": "./dist/antigravity-zenith-light/*",
    "./antigravity-lagoon-dark/*": "./dist/antigravity-lagoon-dark/*",
    "./antigravity-lagoon-light/*": "./dist/antigravity-lagoon-light/*",
    "./antigravity-solar-dark/*": "./dist/antigravity-solar-dark/*",
    "./antigravity-solar-light/*": "./dist/antigravity-solar-light/*",
    "./antigravity-nova-dark/*": "./dist/antigravity-nova-dark/*",
    "./antigravity-nova-light/*": "./dist/antigravity-nova-light/*",
    "./antigravity-nebula-dark/*": "./dist/antigravity-nebula-dark/*",
    "./antigravity-nebula-light/*": "./dist/antigravity-nebula-light/*",
    "./runtime/*": "./dist/runtime/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsx src/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:asar": "node tests/test-asar-patcher.mjs",
    "pack:release": "tsx scripts/pack-release.ts",
    "doctor": "node scripts/check-host-compat.mjs",
    "check:upstream": "tsx scripts/check-upstream-app.ts",
    "check:host-compat": "node scripts/check-host-compat.mjs",
    "check:host-upstream": "node scripts/check-antigravity-upstream.mjs",
    "preview": "tsx scripts/serve-preview.ts",
    "sync:readme": "tsx scripts/sync-release-readme.ts",
    "ci:version": "changeset version && pnpm build && pnpm sync:readme",
    "ci:publish": "pnpm pack:release && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.14.0",
    "ajv": "^8.17.1",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "happy-dom": "^21.0.4",
    "shiki": "^3.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
